{
  "name": "classforge-vscode",
  "displayName": "ClassForge",
  "description": "Upload ClassForge projects, view feedback and start requested changes without leaving VS Code.",
  "version": "0.1.0",
  "publisher": "classforge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "classforge",
    "education",
    "grading",
    "project"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "classforge.signIn",
        "title": "ClassForge: Sign In"
      },
      {
        "command": "classforge.signOut",
        "title": "ClassForge: Sign Out"
      },
      {
        "command": "classforge.selectCourse",
        "title": "ClassForge: Select Course"
      },
      {
        "command": "classforge.selectAssignment",
        "title": "ClassForge: Select Assignment"
      },
      {
        "command": "classforge.previewSubmission",
        "title": "ClassForge: Preview Files to Upload"
      },
      {
        "command": "classforge.submitProject",
        "title": "ClassForge: Upload Project Files"
      },
      {
        "command": "classforge.checkStatus",
        "title": "ClassForge: Check Feedback"
      },
      {
        "command": "classforge.showFeedback",
        "title": "ClassForge: View Feedback"
      },
      {
        "command": "classforge.createRevisionBranch",
        "title": "ClassForge: Start Requested Changes"
      },
      {
        "command": "classforge.openDashboard",
        "title": "ClassForge: Open ClassForge Website"
      }
    ],
    "configuration": {
      "title": "ClassForge",
      "properties": {
        "classforge.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL of the ClassForge server."
        },
        "classforge.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of files allowed in one upload."
        },
        "classforge.maxBytes": {
          "type": "number",
          "default": 52428800,
          "minimum": 1024,
          "description": "Maximum total size of an upload in bytes."
        },
        "classforge.requestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "HTTP request timeout for ClassForge API calls."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}

# Copy to .env and adjust for your machine. ClassForge reads these from the
# process environment; Django does not load .env files by itself.
# Example (PowerShell): $env:DB_ENGINE = 'sqlite'; python manage.py runserver

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
# Comma-separated host names; required when DJANGO_DEBUG=0.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# sqlite (default) or mysql
DB_ENGINE=sqlite
# Used only when DB_ENGINE=mysql
DB_NAME=bsitcrud
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Optional media root; defaults to ./media
# DJANGO_MEDIA_ROOT=D:/data/classforge/media

# --- AI assessment (optional) ---------------------------------------------
# Leave AI_API_KEY empty to use the deterministic local inspector. When a key
# is set, assessment.py calls an OpenAI-compatible chat-completions endpoint.
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_TIMEOUT=45

# inline | thread | celery
# inline is the safe development default; production should use celery or an
# isolated runner. Celery packages/worker are not bundled with this project.
AI_EVALUATION_MODE=inline
ASSESSMENT_DISPATCH_MODE=inline

# --- Snapshot upload limits ------------------------------------------------
CLASSFORGE_MAX_UPLOAD_MB=25
CLASSFORGE_MAX_SNAPSHOT_FILES=500
CLASSFORGE_MAX_SNAPSHOT_BYTES=52428800
# CLASSFORGE_SNAPSHOT_ROOT=D:/data/classforge/project_snapshots

# --- Code/test execution boundary -----------------------------------------
# Keep "disabled" unless you have an isolated, sandboxed runner. Student code
# and SQL are never executed in the Django process.
CLASSFORGE_TEST_RUNNER=disabled
CLASSFORGE_TEST_TIMEOUT=120

# --- Server-owned Git mirror ----------------------------------------------
CLASSFORGE_GIT_ENABLED=1
CLASSFORGE_GIT_AUTHOR=ClassForge
CLASSFORGE_GIT_EMAIL=classforge@localhost

# --- API tokens and throttling --------------------------------------------
CLASSFORGE_TOKEN_TTL_DAYS=30
CLASSFORGE_API_RATE_LIMIT=120
CLASSFORGE_API_RATE_WINDOW=60

# --- Assessment queue resilience ------------------------------------------
ASSESSMENT_MAX_ATTEMPTS=3
ASSESSMENT_STALE_AFTER_MINUTES=30
